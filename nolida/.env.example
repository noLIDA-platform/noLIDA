# App
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_NAME=noLIDA
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Database (Supabase)
DATABASE_URL=

# Auth secrets
SESSION_SECRET=
JWT_SECRET=

# DEV ONLY — bypass OTP during signup.
# Requires BOTH:
#   - DEV_BYPASS_OTP=true
#   - The email being registered is listed in DEV_BYPASS_EMAILS
# Emails are comma-separated, lowercase, exact match only.
# Leave DEV_BYPASS_EMAILS empty to disable bypass entirely.
DEV_BYPASS_OTP=
DEV_BYPASS_EMAILS=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# SMS (Termii)
TERMII_API_KEY=
TERMII_SENDER_ID=

# Google OAuth (Phase 6)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign-In (Phase 6)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Payments (Flutterwave)
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Error tracking (Sentry)
SENTRY_DSN=

# Analytics (PostHog)
POSTHOG_KEY=
